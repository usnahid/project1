# RoadGuard AI — Environment Configuration Example

# Backend Application Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
APP_NAME="RoadGuard AI"
APP_VERSION="1.0.0"

# Geospatial Proximity Duplicate Radius (meters)
DUPLICATE_DISTANCE_THRESHOLD_METERS=50.0

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Upload Limits
MAX_IMAGE_SIZE_BYTES=15728640

# Database
DATABASE_URL="sqlite:///./roadguard.db"
